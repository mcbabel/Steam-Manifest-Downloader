# =============================================================================
# Steam Manifest Downloader - .gitignore
# =============================================================================

# ---- Rust / Cargo ----
target/

# ---- Build output ----
dist/

# ---- Node.js ----
node_modules/

# ---- App output directories ----
downloads/
uploads/
data/

# ---- Old Node.js source (superseded by Rust) ----
/src/

# ---- Development plans (internal) ----
plans/

# ---- Screenshots ----
/screenshots/
!assets/screenshots/

# ---- OS generated files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor ----
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# ---- Temp / log files ----
*.log
*.tmp

# ---- Debug symbols ----
*.pdb
*.AppImage

# ---- Environment ----
.env
.env.*
!*.env.example
!.env.example

# Build scripts
assets/generate-*.js

# Temp files
RELEASE_NOTES.md

# ---- Remote file signing key ----
*.key
smd-remote.key*
